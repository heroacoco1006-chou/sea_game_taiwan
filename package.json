{
  "name": "sea-game-taiwan",
  "version": "2.4.1",
  "private": true,
  "description": "大航海福爾摩沙 — 台灣大航海時代歷史教育遊戲",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "validate:reputation": "node tools/validate-reputation-events.mjs",
    "test:reputation": "node --experimental-loader ./tools/node-ts-json-loader.mjs tools/test-reputation-events.mjs",
    "test:shipyard": "node --experimental-loader ./tools/node-ts-json-loader.mjs tools/test-shipyard-repair.mjs",
    "preview": "vite preview",
    "validate:exploration": "node tools/validate-exploration-v22.mjs && python tools/validate-exploration-event-images.py",
    "validate:loading": "node tools/validate-loading-hud.mjs",
    "validate:mobile-layout": "node tools/validate-mobile-layout.mjs",
    "validate:text": "node tools/validate-game-text.mjs",
    "validate:tutorial": "node tools/validate-tutorial-data.mjs",
    "test:exploration": "node --experimental-loader ./tools/node-ts-json-loader.mjs tools/test-exploration-v22.mjs",
    "test:tutorial": "node --experimental-loader ./tools/node-ts-json-loader.mjs tools/test-tutorial-engine.mjs",
    "validate:town-hd2d": "node tools/validate-town-hd2d.mjs",
    "test:town-navigation": "node --experimental-loader ./tools/node-ts-json-loader.mjs tools/test-town-navigation.mjs"
  },
  "dependencies": {
    "phaser": "^3.87.0",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@types/three": "0.162.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
